# 운영 환경변수 템플릿. 서버에서 .env.prod 로 복사해 실제 값으로 채운다.
#   cp .env.prod.example .env.prod  &&  vi .env.prod
# .env.prod 는 절대 커밋하지 않는다(.gitignore 처리됨).

# --- 프론트 정적 파일 경로 (서버에서 team04-front 클론 위치) ---
FRONTEND_DIR=../team04-front

# --- 프로파일 (소셜 로그인까지 켜려면 prod,oauth) ---
SPRING_PROFILES_ACTIVE=prod

# --- 데이터베이스 ---
POSTGRES_DB=firstbite
POSTGRES_USER=firstbite
POSTGRES_PASSWORD=change-me-strong-db-password

# --- 필수 보안 시크릿 (강한 랜덤값으로 교체) ---
# 생성 예: openssl rand -base64 48
JWT_SECRET=replace-with-random-at-least-32-bytes-secret
PHONE_ENCRYPTION_KEY=replace-with-a-long-random-secret
PHONE_HMAC_KEY=replace-with-another-long-random-secret

# --- 쿠키 정책 ---
# 도메인+HTTPS 전(같은 오리진 HTTP): 아래 그대로.
# HTTPS 붙인 뒤: REFRESH_COOKIE_SECURE=true, 서브도메인 분리 시 SAME_SITE=None
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax
CORS_ALLOWED_ORIGINS=http://1.201.116.77

# --- 휴대폰 인증(OCTOMO) ---
# 실제 키가 없으면 임시로 목 사용(문자 확인을 항상 성공 처리). 운영 오픈 전엔 실제 키로 교체 권장.
APP_OCTOMO_MOCK=true
OCTOMO_API_KEY=
OCTOMO_RECEIVER_NUMBER=16663538

# --- 선택: 사진 인식(OpenAI) / 이미지 저장(S3) ---
OPENAI_API_KEY=
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# --- 선택: 소셜 로그인 (SPRING_PROFILES_ACTIVE=prod,oauth 로 켤 때만) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
OAUTH_SUCCESS_REDIRECT=http://1.201.116.77/index.html
OAUTH_FAILURE_REDIRECT=http://1.201.116.77/login.html
